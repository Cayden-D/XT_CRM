NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ai_crm
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_TO_AT_LEAST_32_RANDOM_CHARACTERS
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://127.0.0.1:5173
DASHSCOPE_API_KEY=YOUR_DASHSCOPE_API_KEY
# 使用业务空间时替换为 https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_DEFAULT_MODEL=qwen3.8-flash
QWEN_TIMEOUT_MS=60000

# Private OSS bucket for generated image previews. Use a RAM identity limited to this bucket/prefix.
OSS_REGION=oss-cn-beijing
OSS_BUCKET=your-private-bucket
# OSS_ACCESS_KEY_ID=your-ram-access-key-id
# OSS_ACCESS_KEY_SECRET=your-ram-access-key-secret
# Optional: HTTPS custom domain already bound to the Bucket with CNAME and certificate.
# OSS_CUSTOM_DOMAIN=https://img.example.com
# 电商套图（GPT-Image-2.5，经 APIMart）：https://apimart.ai/keys 获取密钥；未配置时套图功能不可用
# APIMART_API_KEY=
# APIMART_BASE_URL=https://api.apimart.ai/v1
# 图片任务后台轮询间隔与并发
# IMAGE_WORKER_POLL_MS=4000
# IMAGE_WORKER_CONCURRENCY=3
AGENT_QUEUE_CONCURRENCY=2
AGENT_QUEUE_POLL_MS=3000

ALI1688_APP_KEY=你的AppKey
ALI1688_APP_SECRET=你的AppSecret
ALI1688_REDIRECT_URI=开放平台已登记的回调地址
# 绩效应用：独立于商品应用，必须单独授权；禁止复用商品令牌。
ALI1688_PERFORMANCE_APP_KEY=绩效应用AppKey
ALI1688_PERFORMANCE_APP_SECRET=绩效应用AppSecret
ALI1688_PERFORMANCE_REDIRECT_URI=绩效应用已登记的回调地址
# 可选：绩效同步间隔（毫秒，默认 15 分钟）、队列轮询间隔与首次同步天数
# PERF_SYNC_INTERVAL_MS=900000
# PERF_SYNC_POLL_MS=5000
# PERF_SYNC_INITIAL_DAYS=7
# 每店铺绩效接口调用上限（次/秒），网关限流时自动退避重试
# PERF_SYNC_MAX_QPS=4
# 定时同步每店每日调用上限：开发测试中应用流量为 5000 次/天，上线后 10 万次/天；达到上限或被平台限流后当天不再自动同步
# PERF_SYNC_DAILY_CALLS=4500
# 生产环境必填：独立的 32 字节随机密钥，使用 64 个十六进制字符，不是 AppSecret。
# 开发环境未配置时使用权限为 0600 的 .1688-key.local；备份数据库时需同时保管密钥。
# ALI1688_TOKEN_ENCRYPTION_KEY=
